---
import Ban from '@lucide/astro/icons/ban'
import CalendarCheck from '@lucide/astro/icons/calendar-check'
import Clock from '@lucide/astro/icons/clock'
import DateList from '../components/DateList.astro'
import Notice from '../components/Notice.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { location } from '../data/site.js'
import { loadPublicSessions, PUBLIC_CACHE } from '../lib/public-sessions.js'

export const prerender = false

const { sessions, unavailable } = await loadPublicSessions()
Astro.cache.set(PUBLIC_CACHE)

const tips = [
  { icon: CalendarCheck, text: 'CFSC runs on Saturday and CRFSC on Sunday. Taking only the CFSC? You finish on Saturday.' },
  { icon: Clock, text: 'Allow for the full scheduled course and exam time, and avoid other plans that weekend.' },
  { icon: Ban, text: 'Electronic devices (laptops, tablets, etc.) are not permitted in the classroom.' },
]
---

<BaseLayout
  title="Course Dates"
  description={`Upcoming CFSC and CRFSC weekend course dates at ${location.name}, Toronto.`}
  eyebrow="When"
  heading="Course dates"
>
  <Fragment slot="intro">Courses are scheduled on weekends. You must register for a course in order to attend.</Fragment>

  <div class="grid items-start gap-8 nav:grid-cols-[1.5fr_1fr]">
    <section class="card px-5 py-2 nav:px-7">
      <div class="border-b border-line py-4">
        <h2 class="card-heading mb-0">{location.name}</h2>
        <p class="text-sm text-muted">{location.street} · Mixed courses available (non-restricted and/or restricted)</p>
      </div>
      <DateList dates={sessions} unavailable={unavailable} />
    </section>

    <aside class="grid gap-4 nav:sticky nav:top-28">
      <div class="card p-6">
        <h2 class="card-heading">Good to know</h2>
        <ul class="mt-3 grid gap-4">
          {
            tips.map(({ icon: Icon, text }) => (
              <li class="flex gap-3">
                <span class="icon-chip size-9">
                  <Icon size={18} />
                </span>
                <span class="body-text text-sm">{text}</span>
              </li>
            ))
          }
        </ul>
        <a class="btn mt-6 w-full" href="/register">Register for a course</a>
      </div>
      <Notice title="Looking for hunter education?">
        See the <a class="link" href="/hunter-education">Ontario Hunter Education Program</a>.
      </Notice>
    </aside>
  </div>
</BaseLayout>
