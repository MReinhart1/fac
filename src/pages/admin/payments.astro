---
import StatusPill from '../../components/admin/StatusPill.astro'
import AdminLayout from '../../layouts/AdminLayout.astro'
import { money } from '../../data/courses.js'
import { weekendParts } from '../../data/dates.js'
import { actorOf, formatDateTime, isOwner, messageFor, readForm, redirectWith } from '../../lib/admin.js'
import { store } from '../../lib/db.js'
import { StoreError } from '../../lib/store.js'
import { refreshDatePages } from '../../lib/public-sessions.js'
import { notifyCancelled, notifyPaid, safely } from '../../lib/email/notify.js'
import { UNPAID_REASON } from '../../lib/email/templates.js'

export const prerender = false

const user = Astro.locals.user
if (!isOwner(user)) return new Response('Only the owner can see payments.', { status: 403 })
const data = store()

// Quick actions from the unpaid list. "Mark paid": full amount by e-Transfer, confirmation emailed.
// "Remove": cancel an unpaid registration (no refund), free the seat and email the student.
if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request)
  try {
    const reg = await data.getRegistration(form.id)
    if (form.action === 'remove') {
      if (reg.status !== 'pending') throw new StoreError('invalid', 'Only unpaid registrations can be removed here. Open the registration instead.')
      await data.cancelRegistration(form.id, { reason: UNPAID_REASON }, actorOf(user))
      await refreshDatePages(Astro.cache)
      await safely(notifyCancelled(form.id, 0))
      return redirectWith(Astro.redirect, '/admin/payments', `${reg.student.firstName} ${reg.student.familyName} removed; seat freed and student emailed.`)
    }
    await data.markPaid(form.id, { method: 'e-Transfer', amountCents: reg.amountDueCents }, actorOf(user))
    await refreshDatePages(Astro.cache)
    await safely(notifyPaid(form.id, reg.amountDueCents))
    return redirectWith(Astro.redirect, '/admin/payments', `${reg.reference} marked paid; confirmation emailed.`)
  } catch (error) {
    return redirectWith(Astro.redirect, '/admin/payments', messageFor(error), 'error')
  }
}

const ref = (Astro.url.searchParams.get('ref') ?? '').trim()
const found = ref ? await data.findByReference(ref) : null
const unpaid = await data.listUnpaid()
const th = 'px-3 py-2.5'
const td = 'px-3 py-2.5 align-top'
---

<AdminLayout title="Payments">
  <form method="get" class="card mb-6 flex flex-wrap items-end gap-3 p-5">
    <label class="field-label min-w-60 flex-1">
      Payment reference from the e-Transfer message
      <input class="field font-mono uppercase" name="ref" value={ref} placeholder="FAC-0116-SMITH-K7Q" autocomplete="off" />
    </label>
    <button class="btn btn-navy" type="submit">Find</button>
  </form>

  {
    ref && (
      <section class="card mb-8 p-5">
        {found ? (
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
              <p class="font-semibold">
                <a class="link" href={`/admin/registrations/${found._id}`}>
                  {found.student.firstName} {found.student.familyName}
                </a>{' '}
                <StatusPill status={found.status} />
              </p>
              <p class="text-sm text-muted">
                {found.reference} · {weekendParts(found.startDate).label} · {found.packageTitle} · {money(found.amountDueCents)}
              </p>
            </div>
            {found.status === 'pending' ? (
              <a class="btn" href={`/admin/registrations/${found._id}`}>Record payment</a>
            ) : null}
          </div>
        ) : (
          <p class="text-sm">No registration has the reference <b class="font-mono">{ref.toUpperCase()}</b>. Check the spelling, or search the class lists.</p>
        )}
      </section>
    )
  }

  <h2 class="card-heading">Unpaid registrations ({unpaid.length})</h2>
  <div class="card overflow-x-auto">
    <table class="w-full min-w-[760px] text-left text-sm">
      <thead class="border-b border-line text-xs tracking-[0.08em] text-muted uppercase">
        <tr>
          <th class={th}>Student</th>
          <th class={th}>Weekend</th>
          <th class={th}>Reference</th>
          <th class={th}>Amount</th>
          <th class={th}>Registered</th>
          <th class={th}></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        {
          unpaid.map((reg) => (
            <tr class="hover:bg-paper">
              <td class={td}>
                <a class="link" href={`/admin/registrations/${reg._id}`}>
                  {reg.student.familyName}, {reg.student.firstName}
                </a>
              </td>
              <td class={td}>{weekendParts(reg.startDate).label}</td>
              <td class:list={[td, 'font-mono']}>{reg.reference}</td>
              <td class={td}>{money(reg.amountDueCents)}</td>
              <td class={td}>{formatDateTime(reg.createdAt)}</td>
              <td class={td}>
                <div class="flex gap-2">
                  <form method="post">
                    <input type="hidden" name="id" value={reg._id.toString()} />
                    <input type="hidden" name="action" value="paid" />
                    <button class="btn btn-outline min-h-9 px-3 text-sm" type="submit">
                      Mark paid
                    </button>
                  </form>
                  <form method="post" data-confirm={`Remove ${reg.student.firstName} ${reg.student.familyName} from ${weekendParts(reg.startDate).label}? Their seat is freed and they are emailed that the registration is cancelled.`}>
                    <input type="hidden" name="id" value={reg._id.toString()} />
                    <input type="hidden" name="action" value="remove" />
                    <button class="btn btn-outline min-h-9 px-3 text-sm" type="submit">
                      Remove
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          ))
        }
        {
          unpaid.length === 0 && (
            <tr>
              <td class="px-3 py-6 text-muted" colspan="6">
                Nothing outstanding.
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>
  <p class="small-note">
    Unpaid students keep their seat until you remove them. “Mark paid” records the full amount by e-Transfer and emails the student their
    course confirmation. “Remove” cancels the registration without a refund, frees the seat and emails the student. For cash, a different
    amount, a note or no email, open the registration.
  </p>
</AdminLayout>

<script>
  // Ask before removing a student.
  for (const form of document.querySelectorAll('form[data-confirm]')) {
    form.addEventListener('submit', (event) => {
      if (!window.confirm(form.dataset.confirm)) event.preventDefault()
    })
  }
</script>
