---
import ArrowRight from '@lucide/astro/icons/arrow-right'
import BadgeCheck from '@lucide/astro/icons/badge-check'
import BookOpen from '@lucide/astro/icons/book-open'
import CalendarCheck from '@lucide/astro/icons/calendar-check'
import ClipboardCheck from '@lucide/astro/icons/clipboard-check'
import GraduationCap from '@lucide/astro/icons/graduation-cap'
import IdCard from '@lucide/astro/icons/id-card'
import Phone from '@lucide/astro/icons/phone'
import Users from '@lucide/astro/icons/users'
import CfpNotice from '../components/CfpNotice.astro'
import CourseCard from '../components/CourseCard.astro'
import DateList from '../components/DateList.astro'
import LocationCard from '../components/LocationCard.astro'
import PackageCard from '../components/PackageCard.astro'
import Rings from '../components/Rings.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { courses, findPackage, money, packages } from '../data/courses.js'
import { location, phone } from '../data/site.js'
import { loadPublicSessions, PUBLIC_CACHE } from '../lib/public-sessions.js'

export const prerender = false

const { sessions, unavailable } = await loadPublicSessions()
Astro.cache.set(PUBLIC_CACHE)

const nextCourse = sessions.find((item) => !item.full)
const cfscPrice = money(findPackage('cfsc').total)
const bothPrice = money(findPackage('package').total)

const highlights = [
  { icon: BadgeCheck, title: 'Designated instructors', text: 'FSESO members, certified by the Chief Firearms Office' },
  { icon: CalendarCheck, title: 'Weekend courses', text: 'CFSC on Saturday, CRFSC on Sunday' },
  { icon: BookOpen, title: 'All-in pricing', text: 'Taxes, exam and student guide included' },
  { icon: Users, title: 'No experience needed', text: 'Students of every level are welcome' },
]

const steps = [
  {
    icon: GraduationCap,
    title: 'Take the course',
    text: 'The CFSC covers non-restricted firearms (long guns). Add the CRFSC on Sunday for restricted firearms (handguns).',
  },
  {
    icon: ClipboardCheck,
    title: 'Pass the exams',
    text: 'Each exam has a written part (50 questions) and a practical part. You need at least 80% on both.',
  },
  {
    icon: IdCard,
    title: 'Apply for your licence',
    text: 'Send your licence (PAL) application to the RCMP Canadian Firearms Program. We are not the CFP.',
  },
]
---

<BaseLayout businessSchema>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy text-cream">
    <Rings class="top-1/2 -right-56 size-[760px] -translate-y-1/2 text-steel/15" />
    <div class="page-width relative grid items-center gap-10 py-14 nav:grid-cols-[1.25fr_1fr] nav:py-24">
      <div>
        <p class="eyebrow-dark">Toronto firearms safety courses</p>
        <h1 class="font-display text-[clamp(40px,6vw,68px)] leading-[0.98] font-extrabold tracking-[-0.03em] text-balance">
          Get trained. Pass the exam. <span class="text-steel">Get licensed.</span>
        </h1>
        <p class="mt-6 max-w-[560px] text-lg leading-relaxed text-cream/80">
          Firearms Academy Canada runs the Canadian Firearms Safety Course (CFSC) and the Restricted course (CRFSC) on weekends in Toronto,
          taught by CFO-designated instructors.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn" href="/register">Register for a course <ArrowRight size={18} /></a>
          <a class="btn btn-outline-light" href="/dates">See course dates</a>
        </div>
      </div>

      <aside class="rounded-2xl bg-cream p-6 text-navy shadow-2xl nav:p-8" aria-labelledby="next-course-heading">
        <p id="next-course-heading" class="eyebrow">Next available course</p>
        <div class:list={{ hidden: !nextCourse }}>
          <p class="font-display text-[30px] leading-tight font-extrabold tracking-[-0.02em]">{nextCourse?.label}</p>
          <p class="mt-1 text-sm text-navy/70">Saturday &amp; Sunday · {location.name}</p>
        </div>
        <p class:list={['font-display text-xl font-bold', { hidden: nextCourse }]}>New dates coming soon</p>
        <dl class="mt-6 grid grid-cols-2 gap-3 border-t border-navy/10 pt-5">
          <div>
            <dt class="text-xs font-semibold text-navy/70">CFSC package</dt>
            <dd class="font-display text-2xl font-extrabold">{cfscPrice}</dd>
          </div>
          <div>
            <dt class="text-xs font-semibold text-navy/70">Both courses</dt>
            <dd class="font-display text-2xl font-extrabold">{bothPrice}</dd>
          </div>
        </dl>
        <p class="mt-1.5 text-xs text-navy/70">Taxes and student guide included. Class sizes are limited.</p>
        <a class="btn btn-navy mt-6 w-full" href={nextCourse ? `/register?date=${nextCourse.start}` : '/register'}>
          Reserve a seat <ArrowRight size={18} />
        </a>
      </aside>
    </div>
  </section>

  <!-- Highlights -->
  <section class="border-b border-line bg-paper">
    <ul class="page-width grid gap-6 py-8 sm:grid-cols-2 nav:grid-cols-4">
      {
        highlights.map(({ icon: Icon, title, text }) => (
          <li class="flex gap-3.5">
            <span class="icon-chip bg-white">
              <Icon size={20} />
            </span>
            <span>
              <strong class="block font-display text-[15px]">{title}</strong>
              <span class="text-sm text-muted">{text}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Steps -->
  <section class="section page-width">
    <div class="max-w-[640px]">
      <p class="eyebrow">How it works</p>
      <h2 class="section-title">Three steps to your firearms licence</h2>
      <p class="lead mt-4">
        You must have a Firearms Licence to acquire firearms or buy ammunition. To get one, take the course from a <a class="link" href="/certified">CFO-designated instructor</a> and pass the exams.
      </p>
    </div>
    <ol class="mt-10 grid gap-5 nav:grid-cols-3">
      {
        steps.map(({ icon: Icon, title, text }, index) => (
          <li class="card relative p-6 nav:p-7">
            <span class="absolute top-5 right-6 font-display text-5xl font-extrabold text-cream" aria-hidden="true">
              {index + 1}
            </span>
            <span class="icon-chip">
              <Icon size={22} />
            </span>
            <h3 class="mt-5 font-display text-xl font-bold">{title}</h3>
            <p class="body-text mt-2">{text}</p>
          </li>
        ))
      }
    </ol>
    <CfpNotice class="mt-6" />
  </section>

  <!-- Courses -->
  <section id="courses" class="scroll-mt-20 bg-paper">
    <div class="section page-width">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-[640px]">
          <p class="eyebrow">Our courses</p>
          <h2 class="section-title">Two courses, one weekend</h2>
          <p class="lead mt-4">Both courses combine lecture with hands-on instruction. Plan to keep the full day free for the course and exam.</p>
        </div>
        <a class="arrow-link" href="/faq">Course FAQ <ArrowRight size={18} /></a>
      </div>
      <div class="mt-10 grid gap-5 nav:grid-cols-2 has-[details[open]]:items-start">
        {courses.map((course, index) => <CourseCard course={course} day={index === 0 ? 'Saturday' : 'Sunday'} dark={index === 1} />)}
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section page-width">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-[640px]">
        <p class="eyebrow">Pricing</p>
        <h2 class="section-title">Simple, all-in prices</h2>
        <p class="lead mt-4">Every price includes taxes, the exam and the student guide. All courses are prepaid in full by Interac e-Transfer.</p>
      </div>
      <a class="arrow-link" href="/pricing">Price breakdown <ArrowRight size={18} /></a>
    </div>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {packages.map((pkg) => <PackageCard pkg={pkg} />)}
    </div>
  </section>

  <!-- Dates + location -->
  <section class="bg-paper">
    <div class="section page-width grid gap-8 nav:grid-cols-2">
      <div>
        <p class="eyebrow">When</p>
        <h2 class="section-title">Upcoming course dates</h2>
        <div class="card mt-6 px-5 py-1">
          <DateList dates={sessions} limit={5} unavailable={unavailable} />
        </div>
        <a class="arrow-link mt-5" href="/dates">All course dates <ArrowRight size={18} /></a>
      </div>
      <div>
        <p class="eyebrow">Where</p>
        <h2 class="section-title">One convenient location</h2>
        <div class="mt-6">
          <LocationCard />
        </div>
      </div>
    </div>
  </section>

  <!-- Call to action -->
  <section class="relative overflow-hidden bg-red text-white">
    <Rings class="-top-48 -left-40 size-[560px] text-white/10" />
    <div class="page-width relative flex flex-col items-start justify-between gap-6 py-14 nav:flex-row nav:items-center">
      <div>
        <h2 class="font-display text-[clamp(26px,3.2vw,36px)] leading-tight font-extrabold tracking-[-0.02em]">Questions before you book?</h2>
        <p class="mt-2 text-white/85">Read the FAQ or call us. You can leave a message any time.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a class="btn bg-white text-red hover:bg-cream" href={phone.href}><Phone size={18} /> {phone.display}</a>
        <a class="btn bg-transparent ring-2 ring-white/70 ring-inset hover:bg-white/10" href="/faq">Read the FAQ</a>
      </div>
    </div>
  </section>
</BaseLayout>

