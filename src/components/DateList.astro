---
import ArrowRight from '@lucide/astro/icons/arrow-right'
import { phone } from '../data/site.js'

interface Props {
  /** Upcoming weekends from loadPublicSessions(). */
  dates: { id: string; start: string; label: string; month: string; days: string; full: boolean; seatsLeft: number }[]
  /** Show only the next N dates. */
  limit?: number
  /** The database could not be reached. */
  unavailable?: boolean
}

const { dates, limit, unavailable = false } = Astro.props
const shown = limit ? dates.slice(0, limit) : dates
---

<div>
  <ul class="divide-y divide-line">
    {
      shown.map((item) => (
        <li class="flex items-center gap-4 py-3.5">
          <div class="grid w-16 shrink-0 place-items-center rounded-lg bg-cream py-2 text-center leading-none text-navy">
            <span class="text-[11px] font-bold tracking-[0.1em] text-red uppercase">{item.month}</span>
            <span class="mt-1 font-display text-lg font-extrabold">{item.days}</span>
          </div>
          <div class="min-w-0 flex-1">
            <p class="font-semibold">{item.label}</p>
            <p class="text-[13px] text-muted">
              Saturday &amp; Sunday{!item.full && item.seatsLeft <= 5 && ` · ${item.seatsLeft} ${item.seatsLeft === 1 ? 'seat' : 'seats'} left`}
            </p>
          </div>
          {item.full ? (
            <span class="pill pill-full">Full</span>
          ) : (
            <a class="pill pill-available gap-1 hover:bg-navy hover:text-white" href={`/register?date=${item.start}`}>
              Available <ArrowRight size={14} />
            </a>
          )}
        </li>
      ))
    }
  </ul>
  {
    shown.length === 0 && (
      <p class="body-text py-4">
        {unavailable ? 'Course dates could not be loaded right now. ' : 'New dates are coming soon. '}
        Please <a class="link" href="/contact">contact us</a> or call <a class="link" href={phone.href}>{phone.display}</a> for the next available course.
      </p>
    )
  }
</div>
