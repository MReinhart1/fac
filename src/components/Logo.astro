---
import { site } from '../data/site.js'

interface Props {
  /** Light text for dark backgrounds. */
  inverse?: boolean
}

const { inverse = false } = Astro.props
---

<a class="group inline-flex items-center gap-3" href="/" aria-label={`${site.name} home`}>
  <svg class="size-11 shrink-0" viewBox="0 0 48 48" aria-hidden="true">
    <rect width="48" height="48" rx="11" class={inverse ? 'fill-cream' : 'fill-navy'}></rect>
    <text
      x="24"
      y="27.5"
      text-anchor="middle"
      class:list={['font-display text-[15px] font-extrabold tracking-[0.5px]', inverse ? 'fill-navy' : 'fill-cream']}>FAC</text
    >
    <rect x="13" y="33" width="22" height="3" rx="1.5" class="fill-red"></rect>
  </svg>
  <span class:list={['font-display leading-[1.05] whitespace-nowrap', inverse ? 'text-cream' : 'text-navy']}>
    <span class="block text-[15px] font-extrabold tracking-[-0.01em]">Firearms Academy</span>
    <span class:list={['block text-[11px] font-bold tracking-[0.22em] uppercase', inverse ? 'text-steel' : 'text-red']}>Canada</span>
  </span>
</a>
