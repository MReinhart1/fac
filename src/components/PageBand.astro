---
import Rings from './Rings.astro'

interface Props {
  eyebrow: string
  title: string
  /** Rendered HTML for the intro paragraph. */
  intro?: string
  /** Hide the whole band when printing (consent form prints only the form). */
  hideOnPrint?: boolean
}

const { eyebrow, title, intro, hideOnPrint = false } = Astro.props
---

<section class:list={['relative overflow-hidden border-b border-line bg-paper', { 'print:hidden': hideOnPrint }]}>
  <Rings class="-top-40 -right-40 size-[520px] text-red/[0.07] max-nav:hidden" />
  <div class="page-width relative py-12 nav:py-16">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="max-w-[820px] font-display text-[clamp(36px,5vw,58px)] leading-[1.02] font-extrabold tracking-[-0.025em] text-balance">
      {title}
    </h1>
    {intro && <p class="lead mt-4 max-w-[640px]" set:html={intro} />}
  </div>
</section>
