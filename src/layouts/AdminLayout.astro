---
import { roleLabel, isOwner } from '../lib/admin.js'
import '../styles/global.css'

interface Props {
  title: string
}

const { title } = Astro.props
const user = Astro.locals.user
const path = Astro.url.pathname
const ok = Astro.url.searchParams.get('ok')
const error = Astro.url.searchParams.get('error')

const links = [
  { href: '/admin', label: 'Dashboard', ownerOnly: false },
  { href: '/admin/sessions', label: 'Course weekends', ownerOnly: false },
  { href: '/admin/payments', label: 'Payments', ownerOnly: true },
  { href: '/admin/messages', label: 'Messages', ownerOnly: true },
  { href: '/admin/emails', label: 'Emails', ownerOnly: true },
].filter((link) => !link.ownerOnly || isOwner(user))
const current = (href: string) => (href === '/admin' ? path === '/admin' : path.startsWith(href))
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | FAC staff</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen min-w-80 bg-paper font-sans text-navy antialiased">
    {
      user && (
        <header class="bg-navy text-cream print:hidden">
          <div class="page-width flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3">
            <a class="font-display font-extrabold" href="/admin">
              FAC staff
            </a>
            <nav class="flex flex-wrap gap-1 text-sm font-semibold" aria-label="Staff navigation">
              {links.map((link) => (
                <a
                  class="rounded-md px-3 py-1.5 hover:bg-cream/10 aria-[current=page]:bg-cream aria-[current=page]:text-navy"
                  href={link.href}
                  aria-current={current(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              ))}
            </nav>
            <form method="post" action="/admin/logout" class="flex items-center gap-3 text-sm">
              <span class="text-cream/75">
                {user.name} · {roleLabel(user.role)}
              </span>
              <button class="cursor-pointer rounded-md px-3 py-1.5 font-semibold ring-1 ring-cream/40 hover:bg-cream/10" type="submit">
                Sign out
              </button>
            </form>
          </div>
        </header>
      )
    }
    <main class="page-width py-8 print:p-0">
      <h1 class="mb-6 font-display text-3xl font-extrabold tracking-[-0.02em]">{title}</h1>
      {ok && <p class="mb-5 rounded-lg bg-success-soft px-4 py-3 text-sm font-semibold text-success-ink print:hidden" role="status">{ok}</p>}
      {error && <p class="mb-5 rounded-lg bg-danger-soft px-4 py-3 text-sm font-semibold text-danger-ink print:hidden" role="alert">{error}</p>}
      <slot />
    </main>
  </body>
</html>
