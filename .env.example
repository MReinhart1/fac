# Local settings for `npm run dev` and the scripts. On Cloudflare, store these with `npx wrangler secret put NAME`.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Keep the real value in .env only.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster.
MONGODB_DB=fac

# Staff login (Better Auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's public address: http://localhost:4321 locally (the live value is set in wrangler.jsonc).
BETTER_AUTH_URL=http://localhost:4321

# Protects the hourly job (/api/cron/hourly). Cloudflare's cron trigger sends it via src/worker.js.
# Generate with: openssl rand -hex 24
CRON_SECRET=

# Email via Resend (https://resend.com). Verify firearmsacademy.ca in Resend first.
# Without RESEND_API_KEY the site still works; emails are recorded as "not sent" in the staff portal's email log.
RESEND_API_KEY=
# Until the domain is verified, Resend's test sender works but only delivers to the Resend account owner:
# EMAIL_FROM=Firearms Academy Canada <onboarding@resend.dev>
EMAIL_FROM=Firearms Academy Canada <bookings@firearmsacademy.ca>
# Where students' replies go (optional; defaults to the From address).
EMAIL_REPLY_TO=
# Who gets "new registration" and "new contact message" emails.
OWNER_NOTIFY_EMAIL=
